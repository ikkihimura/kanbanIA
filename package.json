{
  "name": "kanbania",
  "private": true,
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run tauri -w apps/desktop -- dev",
    "tauri": "npm run tauri -w apps/desktop --",
    "build:web": "npm run build -w apps/desktop",
    "lint": "npm run lint -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings && cargo check -p kanbania-runner --no-default-features --locked",
    "test:rust": "cargo test --workspace --locked && npm run check:mcp-deps",
    "check:mcp-deps": "node scripts/check-mcp-deps.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "check": "npm run contracts && npm run format:check && npm run lint && npm run build:web && npm run test:web && npm run lint:rust && npm run test:rust",
    "test:web": "npm run test -w apps/desktop",
    "contracts": "cargo test -p kanbania-core --lib --locked --quiet"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "overrides": {
    "jsdom": "29.1.1"
  }
}
